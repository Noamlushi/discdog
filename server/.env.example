PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://jgames:jgames_dev_pw@localhost:27017/jgames?authSource=admin
JWT_SECRET=replace_me_with_a_long_random_string
# Comma-separated list. Add http://<your-lan-ip>:3000 to open the app from a
# phone on the same Wi-Fi without deploying.
CLIENT_ORIGIN=http://localhost:3000

# Bootstrap admin account, created/updated by `npm run seed:admin` (§9.3).
ADMIN_EMAIL=admin@jgames.local
ADMIN_PASSWORD=change_me
ADMIN_NAME=J'Games Admin
